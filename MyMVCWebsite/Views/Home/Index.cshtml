@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="row glow-bg">
    <div class="col-lg-6 my-5">
        <div class="hero-section">
            <h1 class="text-emphasis">Brandon Chase</h1>
            <h2 class="text-emphasis">Full-Stack Software Developer</h2>
            <h3>3+ years developing with ASP.NET</h3>
            <div class="links-wrap mt-5">
                <a class="btn btn-outline-portfolio" href="~/files/Brandon Chase - Software Developer.docx.pdf" download>Resume</a>
                <a href="https://github.com/bchase93" target="_blank"><i class="fa-brands fa-github"></i></a>
                <a href="https://www.linkedin.com/in/brandon-chase-610a14199" target="_blank"><i class="fa-brands fa-linkedin"></i></a>
            </div>
        </div>
    </div>
    <div class="col-lg-6 my-5">
        @await Html.PartialAsync("_Intro")
        @await Html.PartialAsync("_Experience.cshtml", Model.Experience)
        @await Html.PartialAsync("_Projects.cshtml", Model.Projects)
    </div>
</div>

@* @await Html.PartialAsync("_Skills", Model.Skills) *@
<style>
    
</style>

<script>
    const glow = document.querySelector('.glow-bg');

    document.addEventListener('mousemove', (e) => {
        glow.style.setProperty('--x', `${e.clientX}px`);
        glow.style.setProperty('--y', `${e.clientY}px`);
    });
</script>