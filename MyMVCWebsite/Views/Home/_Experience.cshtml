@model List<ExperienceModel>

@foreach (var job in Model)
{
    bool hasLink = !string.IsNullOrWhiteSpace(job.URL);
    string hoverClass = hasLink ? "hover-scale-lg" : "";

    <div class="row experience-wrap my-5">
        <div class="col-3">
            <span class="date-range">@job.EmploymentDates</span>
        </div>

        <div class="col-9">
            <h4 class="text-emphasis @hoverClass">

                @if (hasLink)
                {
                    <a href="@job.URL" target="_blank">
                        @job.Title
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>
                }
                else
                {
                    @job.Title
                }

            </h4>

            <p>@job.Description</p>

            <ul class="skills-wrap">
                @foreach (var skill in job.Skills)
                {
                    <li class="skill">@skill.Name</li>
                }
            </ul>
        </div>
    </div>
}